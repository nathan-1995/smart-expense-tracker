# Server Configuration
PORT=8000

# Database Configuration (Neon PostgreSQL)
# Example: postgresql+asyncpg://user:password@ep-xxx-xxx.us-east-1.aws.neon.tech/fintrack?sslmode=require
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.neon.tech/fintrack?sslmode=require

# JWT Configuration
JWT_SECRET_KEY=-secret-key-here-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Service (ZeptoMail)
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_API_KEY=zeptomail-api-key
FROM_EMAIL=noreply@fintracker.cc

# Frontend URL (for email links)
# Update with your Railway frontend URL after deployment
FRONTEND_URL=https://fintrack-frontend.up.railway.app

# CORS Origins (JSON array format)
# Add  Railway frontend URL here after deployment
BACKEND_CORS_ORIGINS=["https://fintracker.cc","https://fintrack-frontend.up.railway.app","http://localhost:3000"]

# Optional: Document Processing (Google Gemini)
GEMINI_API_KEY=gemini-api-key-optional
GEMINI_MODEL=gemini-2.5-flash

# Application Settings
DEBUG=False
BCRYPT_COST_FACTOR=12
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# Document Processing Configuration
MAX_DOCUMENT_SIZE_MB=10
DOCUMENT_PROCESSING_TIMEOUT_SECONDS=45
