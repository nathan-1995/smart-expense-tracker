# Railway Environment Variables
# These should be configured in Railway dashboard under "Variables"

# Backend API URL (Railway Backend URL)
# Update with your actual Railway backend URL after deployment
NEXT_PUBLIC_API_URL=https://fintrack-backend.up.railway.app/api/v1

# Environment
NEXT_PUBLIC_ENVIRONMENT=production

# Application Settings
NEXT_PUBLIC_APP_NAME=FinTrack
NEXT_PUBLIC_APP_VERSION=1.0.0


